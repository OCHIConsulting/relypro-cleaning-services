# Cloudflare Pages Functions local/production secret names. Never commit real values.
LEAD_DESTINATION_URL=https://example.invalid/relypro-leads
LEAD_DESTINATION_TOKEN=replace-in-secret-store
RATE_LIMIT_SALT=replace-with-a-long-random-secret
# Bind a KV namespace as LEAD_DEDUPLICATION for 24-hour retry deduplication and hashed rate-limit counters.

# Direct HubSpot mode (alternative to LEAD_DESTINATION_URL). Keep the token in
# Cloudflare's secret store; never commit it or expose it to browser code.
# LEAD_DESTINATION_PROVIDER=hubspot
# HUBSPOT_ACCESS_TOKEN=replace-in-secret-store
# HUBSPOT_PIPELINE_ID=default
# HUBSPOT_NEW_ENQUIRY_STAGE_ID=appointmentscheduled
