{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "relypro-cleaning-services",
  "pages_build_output_dir": "./_site",
  "compatibility_date": "2026-08-13",
  "vars": {
    "LEAD_DESTINATION_PROVIDER": "hubspot"
  },
  "kv_namespaces": [
    {
      "binding": "LEAD_DEDUPLICATION",
      "id": "e87d64618da7482cb5eb5d6fd0195ac8"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "LEAD_DESTINATION_PROVIDER": "hubspot"
      },
      "kv_namespaces": [
        {
          "binding": "LEAD_DEDUPLICATION",
          "id": "aa7382e1fe3b4b30a0b2367bea61c5a3"
        }
      ]
    }
  }
}
