<article class="blog-card h-100">
  <a class="blog-card__image-link" href="{{ post.url }}" aria-label="Read {{ post.data.title }}">
    <img
      class="blog-card__image"
      src="{{ post.data.image or site.defaultImage }}"
      alt="{{ post.data.imageAlt }}"
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="blog-card__body">
    <div class="blog-card__meta">
      <span class="blog-category">{{ post.data.category }}</span>
      <time datetime="{{ post.date | shortIsoDate }}">{{ post.date | readableDate }}</time>
    </div>
    <h2 class="h4 fw-bold"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p>{{ post.data.description }}</p>
    <a class="blog-card__link" href="{{ post.url }}">
      Read guide <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
